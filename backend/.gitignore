# ==============================================================================
# ResearchPilot API - Git Ignore Rules
# ==============================================================================

# Environment files (API keys & credentials)
.env
.env.local
.env.*.local

# Python Byte-compiled & cache directories
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual Environments
venv/
.venv/
env/
ENV/

# User Uploads & Local Vector Storage
uploads/
chroma_db/
*.sqlite3
*.db

# Celery & Logs
*.log
celerybeat-schedule
celerybeat.pid

# IDE & Editor Settings
.vscode/
.idea/
*.swp
*.swo

# OS generated files
.DS_Store
Thumbs.db
desktop.ini
